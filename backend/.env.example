# Local development settings for the backend.
# Copy to `.env` (gitignored) and adjust. Never commit real credentials.
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Database: either set the individual POSTGRES_* parts, or override the whole
# connection with a single DATABASE_URL (production uses Secret Manager).
POSTGRES_USER=clinical
POSTGRES_PASSWORD=clinical
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clinical
# DATABASE_URL=postgresql+asyncpg://clinical:clinical@localhost:5432/clinical
