{
  "components": {
    "schemas": {
      "AnswerCreate": {
        "properties": {
          "option_id": {
            "title": "Option Id",
            "type": "integer"
          },
          "question_id": {
            "title": "Question Id",
            "type": "integer"
          }
        },
        "required": [
          "question_id",
          "option_id"
        ],
        "title": "AnswerCreate",
        "type": "object"
      },
      "AnswerOptionCreate": {
        "properties": {
          "position": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Position"
          },
          "score": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Score"
          },
          "text": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "score"
        ],
        "title": "AnswerOptionCreate",
        "type": "object"
      },
      "AnswerOptionRead": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "position": {
            "title": "Position",
            "type": "integer"
          },
          "score": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Score",
            "type": "string"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "score",
          "position"
        ],
        "title": "AnswerOptionRead",
        "type": "object"
      },
      "CaseCreate": {
        "properties": {
          "description": {
            "anyOf": [
              {
                "maxLength": 5000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/QuestionCreate"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Questions",
            "type": "array"
          },
          "title": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "questions"
        ],
        "title": "CaseCreate",
        "type": "object"
      },
      "CaseRead": {
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/QuestionRead"
            },
            "title": "Questions",
            "type": "array"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "questions"
        ],
        "title": "CaseRead",
        "type": "object"
      },
      "CaseSummaryRead": {
        "properties": {
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "question_count": {
            "title": "Question Count",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "question_count"
        ],
        "title": "CaseSummaryRead",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "QuestionCreate": {
        "properties": {
          "kind": {
            "default": "single_choice",
            "title": "Kind",
            "type": "string"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/AnswerOptionCreate"
            },
            "maxItems": 50,
            "minItems": 2,
            "title": "Options",
            "type": "array"
          },
          "position": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Position"
          },
          "text": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "options"
        ],
        "title": "QuestionCreate",
        "type": "object"
      },
      "QuestionRead": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/AnswerOptionRead"
            },
            "title": "Options",
            "type": "array"
          },
          "position": {
            "title": "Position",
            "type": "integer"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "kind",
          "position",
          "options"
        ],
        "title": "QuestionRead",
        "type": "object"
      },
      "QuestionScoreRead": {
        "properties": {
          "max_score": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Max Score",
            "type": "string"
          },
          "question_id": {
            "title": "Question Id",
            "type": "integer"
          },
          "score": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Score",
            "type": "string"
          },
          "selected_option_id": {
            "title": "Selected Option Id",
            "type": "integer"
          }
        },
        "required": [
          "question_id",
          "selected_option_id",
          "score",
          "max_score"
        ],
        "title": "QuestionScoreRead",
        "type": "object"
      },
      "SubmissionCreate": {
        "properties": {
          "answers": {
            "items": {
              "$ref": "#/components/schemas/AnswerCreate"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Answers",
            "type": "array"
          }
        },
        "required": [
          "answers"
        ],
        "title": "SubmissionCreate",
        "type": "object"
      },
      "SubmissionResult": {
        "properties": {
          "case_id": {
            "title": "Case Id",
            "type": "integer"
          },
          "earned": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Earned",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "maximum": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Maximum",
            "type": "string"
          },
          "per_question": {
            "items": {
              "$ref": "#/components/schemas/QuestionScoreRead"
            },
            "title": "Per Question",
            "type": "array"
          },
          "percentage": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Percentage",
            "type": "string"
          }
        },
        "required": [
          "id",
          "case_id",
          "earned",
          "maximum",
          "percentage",
          "per_question"
        ],
        "title": "SubmissionResult",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Clinical Case Scoring Platform",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/cases": {
      "get": {
        "operationId": "list_cases_cases_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CaseSummaryRead"
                  },
                  "title": "Response List Cases Cases Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Cases",
        "tags": [
          "clinical-cases"
        ]
      },
      "post": {
        "operationId": "create_case_cases_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaseCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Case",
        "tags": [
          "clinical-cases"
        ]
      }
    },
    "/cases/{case_id}": {
      "get": {
        "operationId": "get_case_cases__case_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "case_id",
            "required": true,
            "schema": {
              "title": "Case Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Case",
        "tags": [
          "clinical-cases"
        ]
      }
    },
    "/cases/{case_id}/submissions": {
      "post": {
        "operationId": "submit_answers_cases__case_id__submissions_post",
        "parameters": [
          {
            "in": "path",
            "name": "case_id",
            "required": true,
            "schema": {
              "title": "Case Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmissionCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit Answers",
        "tags": [
          "case-scoring"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Liveness: the process is up, independent of dependencies.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/ready": {
      "get": {
        "description": "Readiness: 200 when the datastore is reachable, 503 otherwise.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Ready Ready Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/submissions/{submission_id}": {
      "get": {
        "operationId": "get_submission_submissions__submission_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "submission_id",
            "required": true,
            "schema": {
              "title": "Submission Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Submission",
        "tags": [
          "case-scoring"
        ]
      }
    }
  }
}
