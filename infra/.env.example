# Docker Compose interpolation inputs for infra/docker-compose.*.yml.
#
# Read by the `docker compose` CLI from the project directory (infra/, the folder
# of the first -f file), NOT the repo root; substituted into the compose YAML
# (host ports, DB credentials passed into containers, public API URL). The
# services do not read this file - per-service config lives in backend/.env and
# pipeline/.env (the pipeline is not part of this compose stack).
# Copy this file to `infra/.env` (gitignored).
#
# Required (no default):
POSTGRES_PASSWORD=
# Optional overrides (defaults are inline in the compose files):
POSTGRES_USER=clinical
POSTGRES_DB=clinical
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
PUBLIC_API_URL=http://localhost:8000
