# syntax=docker/dockerfile:1
# Dev frontend image: Next.js dev server with hot reload.
# Source code is bind-mounted at runtime (see infra/docker-compose.dev.yml); the
# container keeps its own node_modules in an anonymous volume. Build context is
# the repository root:
#   docker build -f infra/Dockerfile.frontend.dev -t clinical-frontend-dev .

FROM node:24-alpine
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
EXPOSE 3000
CMD ["npm", "run", "dev"]
