# Local development settings for the extraction pipeline.
# Copy to `.env` (gitignored) and adjust. No secrets committed here: GEMINI_API_KEY
# is left blank and filled only in your local `.env`; otherwise the Vertex adapter
# authenticates via Application Default Credentials (ADC).
GCP_PROJECT=
GCP_LOCATION=europe-west1
# Current Gemini model. Note: older ids (e.g. gemini-2.0-flash / gemini-2.5-flash)
# are retired for new projects on the Developer API; use a current 3.x Flash model.
LLM_MODEL=gemini-3.8-flash

# "mock" = deterministic offline fixtures (local/tests); "vertex" = real Gemini (prod).
LLM_CLIENT=mock
# Backend base URL used by `--post` (HTTP cases sink).
BACKEND_URL=http://localhost:8000

# Optional: Gemini Developer API key (https://aistudio.google.com/apikey). When set,
# the `vertex` client switches to the Developer API (API-key auth; no ADC/project/
# billing) — for local prototyping. Blank => Vertex AI + ADC (production path).
# The Developer API is geo-restricted: requests must originate from a supported
# country, otherwise the provider returns "User location is not supported".
# Free-tier content may be used by Google to improve products: synthetic data only.
GEMINI_API_KEY=